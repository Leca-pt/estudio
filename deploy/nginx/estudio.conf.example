# estudio.example.com — Estúdio (FastAPI em 127.0.0.1:8010). Trocar estudio.example.com pelo teu domínio.
#
# Instalar:
#   cp deploy/nginx/estudio.conf.example /etc/nginx/sites-available/estudio.example.com.conf
#   ln -s /etc/nginx/sites-available/estudio.example.com.conf /etc/nginx/sites-enabled/20-estudio.example.com.conf
#   nginx -t && systemctl reload nginx

upstream director_app {
    server 127.0.0.1:8010;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name estudio.example.com;

    ssl_certificate     /etc/letsencrypt/live/estudio.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/estudio.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Uploads de clips de vídeo (a app valida o limite real).
    client_max_body_size 200M;

    location / {
        proxy_pass http://director_app;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        # Sobrescreve (não acrescenta) para o IP do limite de login não ser falsificável.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name estudio.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
