# Copiar para .env (nunca versionar o .env).

# Chave para assinar a cookie de sessão. Gerar com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Único utilizador com acesso (o email com que entras).
ADMIN_EMAIL=you@example.com

# Hash argon2 da password inicial (obrigatório mudar no primeiro login).
# Gerar com: docker compose run --rm app python -m app.cli hash-password
# Manter as aspas simples (o hash contém '$').
ADMIN_INITIAL_PASSWORD_HASH=''

# true em produção (HTTPS). false só para testes locais sem HTTPS.
COOKIE_SECURE=true

# O endereço onde a app é aberta (o conector MCP e o OAuth usam-no).
# Ex.: http://localhost:8010 (só neste computador), http://192.168.1.50:8010 (rede local), https://estudio.example.com.
PUBLIC_URL=http://localhost:8010

# Onde o Docker publica a app: 127.0.0.1 = só neste computador (ou atrás do nginx); 0.0.0.0 = toda a rede local.
BIND_ADDRESS=127.0.0.1
PORT=8010

# O teu nome na Sala de argumentistas.
AUTHOR_NAME=Autor

# Assistente (fase 5): token de longa duração do Claude Code.
# Gerar no VPS com: claude setup-token   (precisa de subscrição Claude)
# Em alternativa, uma chave da API: ANTHROPIC_API_KEY=...
CLAUDE_CODE_OAUTH_TOKEN=
